{
    "version": 10,
    "cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 0},
    "configurePresets": [
        {
            "name": "windows-msvc",
            "displayName": "Windows x64 (MSVC / Visual Studio 2026)",
            "description": "Generator Visual Studio 18 2026",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-msvc-vs2022",
            "displayName": "Windows x64 (MSVC / Visual Studio 2022)",
            "description": "Generator Visual Studio 18 2022",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build-vs2022",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        }
    ],
    "buildPresets": [
        { 
            "name": "debug",
            "configurePreset": "windows-msvc", 
            "configuration": "Debug" 
        },
        { 
            "name": "release",
            "configurePreset": "windows-msvc", 
            "configuration": "Release" 
        },
        { 
            "name": "debug-vs2022",
            "configurePreset": "windows-msvc-vs2022", 
            "configuration": "Debug" 
        },
        { 
            "name": "release-vs2022",
            "configurePreset": "windows-msvc-vs2022", 
            "configuration": "Release" 
        }
    ]
}